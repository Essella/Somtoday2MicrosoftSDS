<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SyncIdPreview</RootNamespace>
    <AssemblyName>SyncIdPreview</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>Resources\SOMSDS.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="R:\openapi.json">
      <Link>OpenAPIs\openapi.json</Link>
      <ClassName>SomOpenApiClient</ClassName>
      <CodeGenerator>NSwagCSharp</CodeGenerator>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Icon-license.txt" />
    <Content Include="Resources\SOMSDS.ico" />
    <Content Include="Resources\SOMSDS.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.2" />
    <!-- Microsoft.Extensions.Logging - Platform-independent logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>
  <Target Name="AutoAssemblyVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <Year>$([System.DateTime]::UtcNow.Year)</Year>
      <Month>$([System.DateTime]::UtcNow.Month.ToString("00"))</Month>
      <Day>$([System.DateTime]::UtcNow.Day.ToString("00"))</Day>
      <Hour>$([System.DateTime]::UtcNow.Hour.ToString("00"))</Hour>
      <Minute>$([System.DateTime]::UtcNow.Minute.ToString("00"))</Minute>
      <Build>$([System.DateTime]::UtcNow.Month.ToString("00"))$([System.DateTime]::UtcNow.Day.ToString("00"))</Build>
      <Revision>$([System.DateTime]::UtcNow.Hour.ToString("00"))$([System.DateTime]::UtcNow.Minute.ToString("00"))</Revision>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Properties\VersionInfo.cs" Lines="[assembly: System.Reflection.AssemblyVersion(&quot;1.$(Year).$(Build).$(Revision)&quot;)]" Overwrite="true" />
  </Target>
</Project>
