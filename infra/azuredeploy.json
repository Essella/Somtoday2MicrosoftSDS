{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "6054142112736861212"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Volledige naam voor de Azure Container Apps Environment."
      }
    },
    "logAnalyticsName": {
      "type": "string",
      "minLength": 4,
      "maxLength": 63,
      "metadata": {
        "description": "Naam voor de Log Analytics Workspace die bij deze Environment hoort."
      }
    }
  },
  "variables": {
    "environmentTagName": "Somtoday2MicrosoftSDS.environment",
    "existingResourceGroupTags": "[coalesce(resourceGroup().tags, createObject())]",
    "alreadyInitialized": "[and(contains(variables('existingResourceGroupTags'), variables('environmentTagName')), not(empty(trim(string(variables('existingResourceGroupTags')[variables('environmentTagName')])))))]",
    "validatedEnvironmentName": "[if(not(variables('alreadyInitialized')), toLower(trim(parameters('environmentName'))), fail('Deze resource group bevat al een Somtoday2MicrosoftSDS-environment. Maak syncjobs met deploy-sync-job.bicep.'))]"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[parameters('logAnalyticsName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        }
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[variables('validatedEnvironmentName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsName'))]"
      ]
    },
    {
      "type": "Microsoft.Resources/tags",
      "apiVersion": "2024-11-01",
      "name": "default",
      "properties": {
        "tags": "[union(variables('existingResourceGroupTags'), createObject('Somtoday2MicrosoftSDS.environment', variables('validatedEnvironmentName')))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('validatedEnvironmentName'))]"
      ]
    }
  ],
  "outputs": {
    "containerAppsEnvironmentName": {
      "type": "string",
      "value": "[variables('validatedEnvironmentName')]"
    },
    "deployedLogAnalyticsName": {
      "type": "string",
      "value": "[parameters('logAnalyticsName')]"
    }
  }
}